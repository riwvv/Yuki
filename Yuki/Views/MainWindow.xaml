<Window x:Class="Yuki.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Yuki" Height="170" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <SolidColorBrush x:Key="IceBlueBrush" Color="#6FCBFF"/>
        <SolidColorBrush x:Key="OrchidPinkBrush" Color="#FF9FD1"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#FFE9B3"/>
        <SolidColorBrush x:Key="PearlWhiteBrush" Color="#F8F4FF"/>

        <Color x:Key="IceBlueShadow">#906FCBFF</Color>
        <Color x:Key="OrchidShadow">#80FF9FD1</Color>

        <LinearGradientBrush x:Key="PanelBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#232A4A" Offset="0"/>
            <GradientStop Color="#34397A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BorderGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6FCBFF" Offset="0"/>
            <GradientStop Color="#FF9FD1" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="GlowBlobBrush">
            <GradientStop Color="#556FCBFF" Offset="0"/>
            <GradientStop Color="#006FCBFF" Offset="1"/>
        </RadialGradientBrush>

        <VisualBrush x:Key="DotGridBrush"
                     TileMode="Tile"
                     Viewport="0,0,28,28" ViewportUnits="Absolute"
                     Viewbox="0,0,28,28" ViewboxUnits="Absolute"
                     Opacity="0.12">
            <VisualBrush.Visual>
                <Ellipse Width="2" Height="2" Fill="White" Margin="13,13,0,0"/>
            </VisualBrush.Visual>
        </VisualBrush>
    </Window.Resources>

    <!-- Отступ обязателен: иначе DropShadowEffect обрежется по границе окна (см. пояснение в чате) -->
    <Grid Margin="26">
        <Border CornerRadius="24"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderGradientBrush}"
                BorderThickness="1.4">
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource OrchidShadow}" BlurRadius="24" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>

            <Grid>
                <!-- мягкий точечный узор, статичный, без анимации -->
                <Rectangle Fill="{StaticResource DotGridBrush}" RadiusX="24" RadiusY="24"/>

                <!-- декоративное свечение позади баров — "дышит", пока окно видно -->
                <Ellipse Width="170" Height="90" Fill="{StaticResource GlowBlobBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                         Opacity="0.6">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsVisible}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.5" To="0.9" Duration="0:0:2.6" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <!-- снежинки генерируются и анимируются из code-behind (MainWindow.xaml.cs) — рандомная позиция/скорость/размер при каждом перезапуске -->
                <Canvas x:Name="SnowCanvas" ClipToBounds="True"/>

                <Grid Margin="20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="❄" Foreground="{StaticResource IceBlueBrush}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding State}"
                                   Foreground="{StaticResource PearlWhiteBrush}"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="14"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource IceBlueShadow}" BlurRadius="8" ShadowDepth="0"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource BorderGradientBrush}" Opacity="0.35" Margin="10,0,10,10"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Бар 1 -->
                        <Rectangle Fill="{StaticResource OrchidPinkBrush}" Width="7" Margin="4,0" RadiusX="3.5" RadiusY="3.5">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Height" Value="6"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSpeaking}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsVisible}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                         From="6" To="18" Duration="0:0:0.28" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <!-- Бар 2 -->
                        <Rectangle Fill="{StaticResource IceBlueBrush}" Width="7" Margin="4,0" RadiusX="3.5" RadiusY="3.5">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Height" Value="9"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSpeaking}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsVisible}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                         From="9" To="26" Duration="0:0:0.24" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" To="9" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <!-- Бар 3 (центральный, самый высокий) -->
                        <Rectangle Fill="{StaticResource GoldBrush}" Width="7" Margin="4,0" RadiusX="3.5" RadiusY="3.5">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Height" Value="12"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSpeaking}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsVisible}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                         From="12" To="34" Duration="0:0:0.3" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" To="12" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <!-- Бар 4 -->
                        <Rectangle Fill="{StaticResource IceBlueBrush}" Width="7" Margin="4,0" RadiusX="3.5" RadiusY="3.5">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Height" Value="9"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSpeaking}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsVisible}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                         From="9" To="26" Duration="0:0:0.22" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" To="9" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <!-- Бар 5 -->
                        <Rectangle Fill="{StaticResource OrchidPinkBrush}" Width="7" Margin="4,0" RadiusX="3.5" RadiusY="3.5">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Height" Value="6"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSpeaking}" Value="True"/>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=IsVisible}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                         From="6" To="18" Duration="0:0:0.26" AutoReverse="True"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Height" To="6" Duration="0:0:0.3"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
